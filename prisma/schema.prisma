// Quote requests — see docs/05-data-and-api.md.
// Prisma 7 syntax: connection URLs live in prisma.config.ts (CLI, DIRECT_URL) and in
// src/lib/db.ts (runtime, pooled DATABASE_URL via the Neon adapter), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceType {
  FULL_TRUCK_LOAD
  PART_TRUCK_LOAD
  WAREHOUSING
  SUPPLY_CHAIN
  NOT_SURE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model QuoteRequest {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  name        String
  company     String?
  phone       String // normalised +91XXXXXXXXXX
  email       String?
  service     ServiceType
  fromCity    String
  toCity      String
  cargoType   String?
  weightTons  Decimal?    @db.Decimal(8, 2)
  pickupDate  DateTime?   @db.Date
  details     String?
  sourcePage  String? // page the form was submitted from
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      LeadStatus  @default(NEW)
  emailSent   Boolean     @default(false)

  @@index([createdAt])
  @@index([status])
}

// Postgres-backed rate limit (05-data-and-api.md: max 5 submissions / IP / 10 min).
// Stores only a salted SHA-256 of the IP, never the raw address. Rows older than
// the window are safe to delete.
model RateLimitHit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ipHash    String

  @@index([ipHash, createdAt])
}
