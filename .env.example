# Copy to .env.local for local development. Never commit real values.

# ── Neon Postgres ──────────────────────────────────────────
# Pooled connection string (host contains "-pooler") — used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Resend ─────────────────────────────────────────────────
RESEND_API_KEY=""
# Sender on a domain verified in Resend (SPF/DKIM on rcsls.in)
QUOTE_FROM_EMAIL="RCS Logistic <quotes@rcsls.in>"
# RCS inbox(es) that receive quote requests, comma-separated
QUOTE_NOTIFY_TO="info@rcsls.in"

# ── Rate limiting ──────────────────────────────────────────
# Random secret (e.g. `openssl rand -hex 32`) used to hash IPs; raw IPs are never stored
IP_HASH_SALT=""

# ── Site ───────────────────────────────────────────────────
# Production URL, no trailing slash. Leave empty on previews (robots.txt then blocks indexing).
NEXT_PUBLIC_SITE_URL="https://www.rcsls.in"

# ── Optional ───────────────────────────────────────────────
# "true" makes missing server variables stop the server at startup.
# Turn on in Vercel production once Neon and Resend are configured.
REQUIRE_SERVER_ENV=""
