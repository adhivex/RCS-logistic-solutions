# Copy to .env.local for local development. Never commit real values.
# With everything empty the site still runs ("local mode"): quote requests are
# validated and logged to the server console instead of being stored or emailed.

# ── Supabase (Project Settings → API) ──────────────────────
# Local: `npm run db:start` prints these (API URL and service_role key).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Resend ─────────────────────────────────────────────────
RESEND_API_KEY=""
# Sender on a domain verified in Resend (SPF/DKIM on rcsls.in)
QUOTE_FROM_EMAIL="RCS Logistic Solutions <quotes@rcsls.in>"
# RCS inbox(es) that receive quote requests, comma-separated
QUOTE_NOTIFY_TO="info@rcsls.in"

# ── Rate limiting ──────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`), used to hash IPs; raw IPs are never stored
RATE_LIMIT_SALT=""

# ── Site ───────────────────────────────────────────────────
# Production URL, no trailing slash. Leave empty on previews (robots.txt then blocks indexing).
NEXT_PUBLIC_SITE_URL="https://www.rcsls.in"
