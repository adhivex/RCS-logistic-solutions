# ── Database (Neon PostgreSQL) ─────────────────────────────
# Pooled connection string (host contains "-pooler") — used at runtime
DATABASE_URL=
# Direct (non-pooled) connection string — used by Prisma migrations
DIRECT_URL=

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "RCS Website <noreply@yourdomain>"
RESEND_FROM_EMAIL=
# Where new quote/contact notifications are delivered
QUOTE_NOTIFICATION_EMAIL=

# ── Spam protection (Cloudflare Turnstile) ─────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Privacy ────────────────────────────────────────────────
# Random secret (e.g. `openssl rand -hex 32`) used to hash IPs for rate limiting
IP_HASH_SALT=

# ── Site ───────────────────────────────────────────────────
# Full production URL with https://, no trailing slash. Leave empty on previews
# (robots.txt then blocks indexing).
NEXT_PUBLIC_SITE_URL=
# WhatsApp number in international format without + or spaces, e.g. 91XXXXXXXXXX.
# Leave empty to hide the WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
